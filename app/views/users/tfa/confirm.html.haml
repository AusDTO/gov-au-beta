.content-main
  %h1 Confirm two-factor code

  A code has been sent to your phone number. Please enter it below
  to complete your two-factor authentication setup.

  %form{method: :post, action: users_two_factor_confirm_path}
    %p
      %input{name: 'authenticity_token', value: "#{form_authenticity_token}", type: :hidden}
      %input{class: :string, type: :text, name: :phone_number_otp}
    %p
      %input{type: :submit, role: :button, value: 'Confirm'}

  %p

  - unless current_user.account_verified
    %p
      = link_to 'Use a different number', users_two_factor_path