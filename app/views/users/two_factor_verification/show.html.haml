.content-main
  - if current_user.direct_otp
    %h2 Enter the code that was sent to you
  - else
    %h2 Enter the code from your authenticator app

  %p= flash[:notice]

  = form_tag([:users, :two_factor_verification], method: :post) do
    = text_field_tag :code, nil, autocomplete: :off
    = submit_tag 'Submit'

  - if current_user.direct_otp
    = link_to 'Resend code', resend_code_users_two_factor_verification_path, action: :get
  - else
    = link_to 'Send me a code instead', resend_code_users_two_factor_verification_path
  = link_to 'Sign out', destroy_user_session_path, :method => :delete
