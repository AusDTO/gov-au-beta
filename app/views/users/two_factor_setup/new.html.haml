%article.sign-in
  %p= flash[:notice]

  %h1
    Setup two-factor authentication

  - unless current_user.account_verified
    You will need to setup two-factor authentication to complete your account setup.

  %p
    Enter a phone number you have access to that you can use for two-factor authentication.

  %section.sign-in-form
    = form_tag([:users, :two_factor_setup], method: :post) do
      = text_field_tag :phone_number, nil, maxlength: 10
      .form-footer-actions
        .form-options
          %p= submit_tag 'Send code', role: :button
