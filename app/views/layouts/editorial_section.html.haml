= inside_layout 'editorial' do
  = content_for :navbar do
    %ul
      %li= link_to('Submissions', editorial_section_submissions_path(@section))
      %li= link_to("Pages", editorial_section_path(@section))
      %li= link_to("Collaborators", editorial_section_collaborators_path(@section))

  = content_for :toolbar_actions do
    - if @section && can?(:create_in, @section)
      %li
        %span
          %i.fa.fa-file-text
        = link_to 'New page', prepare_editorial_section_nodes_path(@section, parent_id: @node)

    -if @node && can?(:manage, @node)
      %li
        %span
          %i.fa.fa-pencil
        = link_to 'Edit', new_editorial_section_submission_path(@section, node_id: @node)

  = yield
